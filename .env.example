# Alpaca paper trading only
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_ACCOUNT_ID=
ALPACA_PAPER_TRADE=true
VOLGUARD_OPERATOR_TOKEN=

# Optional model-backed thesis generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Safety and strategy configuration
VOLGUARD_KILL_SWITCH=false
# Sized for the $100k Alpaca paper account. A max loss far below the cost of one
# at-the-money spread means the agent can never size a position and always abstains.
VOLGUARD_MAX_LOSS_PER_TRADE=1000
VOLGUARD_MAX_RISK_PERCENT=0.01
VOLGUARD_MAX_DAILY_LOSS=2000
VOLGUARD_MAX_OPEN_POSITIONS=3
VOLGUARD_MAX_PORTFOLIO_RISK_PERCENT=0.05
VOLGUARD_MAX_CONTRACTS=5
VOLGUARD_MAX_SPREAD_PERCENT=0.08
VOLGUARD_MAX_QUOTE_AGE_SECONDS=90
VOLGUARD_MIN_QUOTE_SIZE=5
VOLGUARD_SYMBOLS=SPY,QQQ,IWM,AAPL,MSFT,NVDA

# Strategy shape
VOLGUARD_MIN_DTE=7
VOLGUARD_TARGET_DTE=30
VOLGUARD_MAX_DTE=60
VOLGUARD_LONG_LEG_DELTA=0.55
VOLGUARD_SHORT_LEG_DELTA=0.27
VOLGUARD_MAX_DEBIT_TO_WIDTH=0.7
# Entry gate: ATM IV minus jump-robust realized vol must be at or below this.
VOLGUARD_MAX_ENTRY_VRP=0.0
VOLGUARD_MAX_EVENT_SCORE=60
VOLGUARD_MAX_JUMP_FRACTION=0.35

# Daily bars per symbol. The volatility forecast is worse than the trailing estimator
# below ~520 and gains nothing above it. See docs/evidence/forecast-validation.md.
VOLGUARD_BAR_SESSIONS=520

# Exits
VOLGUARD_TAKE_PROFIT_PERCENT=0.5
VOLGUARD_STOP_LOSS_PERCENT=0.5
VOLGUARD_TIME_STOP_DTE=7

# Autonomy (scheduled runs are driven by an external cron hitting /api/agent/scheduled)
VOLGUARD_SCHEDULE_ENABLED=false
VOLGUARD_SCHEDULE_INTERVAL_MINUTES=15
VOLGUARD_SCHEDULE_MODE=dry-run
VOLGUARD_RUN_TIMEOUT_MS=60000

# Request throttling, per client per minute. Bounds Alpaca API usage; not an auth control.
VOLGUARD_RUN_RATE_LIMIT=30
VOLGUARD_MCP_RATE_LIMIT=10

# Optional official Alpaca MCP bridge
ALPACA_MCP_COMMAND=uvx
ALPACA_MCP_ARGS=alpaca-mcp-server
ALPACA_OPTION_FEED=indicative
ALPACA_STOCK_FEED=iex
